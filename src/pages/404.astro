---
/**
 * pages/404.astro — bilingual (Arabic-first) not-found page.
 *
 * Astro emits dist/404.html; Cloudflare Pages serves it with a 404 status
 * for unknown paths. Added 2026-09-30 after live verification caught the
 * site soft-404ing (bogus URLs rendered the homepage instead of a 404).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'الصفحة غير موجودة | مستحقات';
const description =
  'الصفحة التي تبحث عنها غير موجودة أو تم نقلها. عُد إلى الصفحة الرئيسية أو استخدم حاسبات مستحقات نهاية الخدمة.';
---

<BaseLayout locale="ar" path="/404" title={title} description={description}>
  <section class="mx-auto max-w-2xl px-4 py-16 text-center sm:py-24" aria-labelledby="not-found-title">
    <p class="text-7xl font-black text-brand-200" aria-hidden="true">404</p>
    <h1 id="not-found-title" class="mt-4 text-3xl font-extrabold text-brand-950">
      الصفحة غير موجودة
    </h1>
    <p class="mt-3 text-lg text-brand-700">
      عذراً، الصفحة التي تبحث عنها غير موجودة أو تم نقلها.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-xl bg-gold-400 px-6 py-3 text-base font-extrabold text-brand-950 shadow-lg transition hover:bg-gold-300"
      >
        الصفحة الرئيسية
      </a>
      <a
        href="/calculators/"
        class="rounded-xl border border-brand-300 px-6 py-3 text-base font-bold text-brand-800 transition hover:border-brand-500"
      >
        جميع الحاسبات
      </a>
    </div>

    <div dir="ltr" lang="en" class="mt-12 border-t border-brand-200 pt-8">
      <h2 class="text-2xl font-extrabold text-brand-950">Page not found</h2>
      <p class="mt-2 text-brand-700">
        Sorry, the page you are looking for does not exist or has been moved.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/en/"
          class="rounded-xl bg-gold-400 px-6 py-3 text-base font-extrabold text-brand-950 shadow-lg transition hover:bg-gold-300"
        >
          Homepage
        </a>
        <a
          href="/en/calculators/"
          class="rounded-xl border border-brand-300 px-6 py-3 text-base font-bold text-brand-800 transition hover:border-brand-500"
        >
          All calculators
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
