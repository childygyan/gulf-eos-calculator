---
/**
 * pages/guides/[country].astro — Arabic per-country EOS guide pages (Phase 4).
 * Mirrors under /en/guides/.
 */
import GuidePage from '../../components/GuidePage.astro';
import { allCountrySlugs, codeFromSlug } from '../../lib/countries.js';

export function getStaticPaths() {
  return allCountrySlugs().map((slug) => ({
    params: { country: slug },
    props: { code: codeFromSlug(slug)! },
  }));
}

const { code } = Astro.props;
---

<GuidePage locale="ar" code={code} />
