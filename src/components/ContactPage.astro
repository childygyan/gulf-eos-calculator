---
/**
 * components/ContactPage.astro — general contact page (Phase 5).
 *
 * Shows the placeholder inbox from src/config/site.ts, clearly labeled as
 * a temporary address. No invented phone numbers, office addresses, or
 * contact details anywhere.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import { getDict, type Dict } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { localizedPath } from '../lib/seo.js';
import { articleJsonLd } from '../lib/toolSeo.js';
import { SITE } from '../config/site.js';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const s: Dict['contact'] = dict.contact;
const path = '/contact/';

const jsonLdExtra = articleJsonLd({
  headline: s.heading,
  description: s.pageDescription,
  path,
  locale,
});
---

<BaseLayout
  locale={locale}
  path={path}
  title={s.pageTitle}
  description={s.pageDescription}
  jsonLdExtra={jsonLdExtra}
>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <nav aria-label="breadcrumb" class="text-sm text-brand-500">
      <a href={localizedPath('/', locale)} class="hover:text-brand-800">{dict.nav.home}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{s.heading}</span>
    </nav>

    <h1 class="mt-4 text-3xl font-black text-brand-950 sm:text-4xl">{s.heading}</h1>
    <p class="mt-4 text-lg leading-8 text-brand-700">{s.intro}</p>

    <AdSlot position="in-article" />

    <section class="mt-8 rounded-2xl bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-sm font-bold uppercase tracking-wider text-brand-500">
        {s.emailLabel}
      </h2>
      <p class="mt-3">
        <a
          href={`mailto:${SITE.contactEmail}`}
          class="text-xl font-extrabold text-brand-900 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-brand-700"
        >
          {SITE.contactEmail}
        </a>
      </p>
      <p class="mt-2 text-sm text-brand-500">{s.placeholderNote}</p>
      <p class="mt-4 text-sm leading-7 text-brand-700">{s.noPhoneNote}</p>
    </section>

    <section class="mt-6 grid gap-4 sm:grid-cols-2">
      <a
        href={localizedPath('/corrections/', locale)}
        class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition hover:border-gold-400"
      >
        <p class="font-bold text-brand-900">{s.correctionsCta}</p>
        <p class="mt-1 text-sm text-brand-600 underline">{s.correctionsLink}</p>
      </a>
      <a
        href={localizedPath('/lawyers/', locale)}
        class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition hover:border-gold-400"
      >
        <p class="font-bold text-brand-900">{s.lawyersCta}</p>
        <p class="mt-1 text-sm text-brand-600 underline">{s.lawyersLink}</p>
      </a>
    </section>
  </article>
</BaseLayout>
