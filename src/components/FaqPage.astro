---
/**
 * components/FaqPage.astro — the FAQ hub page (Phase 4).
 *
 * 10 questions: 4 general + 6 country spotlights. Figures in answers are
 * filled from the data model at build time (never hardcoded).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDict, fill } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { EOS_RULES } from '../data/index.js';
import { localizedPath } from '../lib/seo.js';
import { articleJsonLd, faqJsonLd, type FaqItem } from '../lib/toolSeo.js';
import { transitionCutoff } from '../lib/guide.js';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const path = '/faq/';

function minYearsShort(years: number, loc: LocaleCode): string {
  if (loc === 'ar') {
    if (years === 2) return 'سنتان';
    if (years === 1) return 'سنة واحدة';
    return `${years} سنوات`;
  }
  return `${years} year${years === 1 ? '' : 's'}`;
}

const fills: Record<string, string> = {
  saMin: minYearsShort(
    EOS_RULES.SA.scenarios.find((s) => s.id === 'resignation')!.minServiceYears,
    locale,
  ),
  kwCap: String(
    EOS_RULES.KW.scenarios.find((s) => s.id === 'termination')!.capMonths,
  ),
  bhDate: transitionCutoff('BH', locale),
  omDate: transitionCutoff('OM', locale),
};

const faqs: FaqItem[] = dict.faqPage.items.map((item) => ({
  q: fill(item.q, fills),
  a: fill(item.a, fills),
}));

const general = faqs.slice(0, 4);
const byCountry = faqs.slice(4);

const jsonLdExtra = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    JSON.parse(
      articleJsonLd({
        headline: dict.faqPage.heading,
        description: dict.faqPage.pageDescription,
        path,
        locale,
      }),
    ),
    JSON.parse(faqJsonLd(faqs)),
  ],
});
---

<BaseLayout
  locale={locale}
  path={path}
  title={dict.faqPage.pageTitle}
  description={dict.faqPage.pageDescription}
  jsonLdExtra={jsonLdExtra}
>
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <nav aria-label="breadcrumb" class="text-sm text-brand-500">
      <a href={localizedPath('/', locale)} class="hover:text-brand-800">{dict.nav.home}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{dict.faqPage.heading}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-black text-brand-950 sm:text-4xl">{dict.faqPage.heading}</h1>
    <p class="mt-4 text-lg leading-8 text-brand-700">{dict.faqPage.intro}</p>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold text-brand-900">{dict.faqPage.generalTitle}</h2>
      <dl class="mt-4 space-y-4">
        {
          general.map((f) => (
            <div class="rounded-2xl bg-white p-5 shadow-sm">
              <dt class="font-bold text-brand-900">{f.q}</dt>
              <dd class="mt-2 leading-7 text-brand-700">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-extrabold text-brand-900">{dict.faqPage.countryTitle}</h2>
      <dl class="mt-4 space-y-4">
        {
          byCountry.map((f) => (
            <div class="rounded-2xl bg-white p-5 shadow-sm">
              <dt class="font-bold text-brand-900">{f.q}</dt>
              <dd class="mt-2 leading-7 text-brand-700">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-8 rounded-2xl bg-brand-950 p-6 text-white">
      <p class="font-bold text-gold-300">{dict.guides.relatedCompare}</p>
      <p class="mt-2">
        <a
          href={localizedPath('/compare/gulf-eos/', locale)}
          class="underline hover:text-gold-300"
        >
          {dict.footer.compareHubLink}
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
