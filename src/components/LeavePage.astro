---
/**
 * components/LeavePage.astro — leave-balance calculator page (both locales).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from './Disclaimer.astro';
import { getDict } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { COUNTRY_CODES, EOS_RULES } from '../data/index.js';
import { localizedPath } from '../lib/seo.js';
import { softwareAppJsonLd } from '../lib/toolSeo.js';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const t = dict.tools.leave;
const path = '/tools/leave-balance/';

const config = {
  locale,
  countries: COUNTRY_CODES.map((code) => ({
    code,
    name: locale === 'ar' ? EOS_RULES[code].nameAr : EOS_RULES[code].nameEn,
  })),
  strings: { tool: t, common: dict.common },
};

const jsonLdExtra = softwareAppJsonLd({
  name: t.heading,
  description: t.pageDescription,
  path,
  locale,
});

const inputCls =
  'w-full rounded-xl border border-brand-200 bg-white px-4 py-2.5 text-brand-950 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-300';
---

<BaseLayout locale={locale} path={path} title={t.pageTitle} description={t.pageDescription} jsonLdExtra={jsonLdExtra}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <a href={localizedPath('/calculators/', locale)} class="text-sm font-semibold text-brand-600 transition hover:text-gold-600">
      <span class="inline-block rtl:rotate-180" aria-hidden="true">←</span>
      {dict.common.backToCalculators}
    </a>
    <h1 class="mt-4 text-3xl font-black text-brand-950 sm:text-4xl">{t.heading}</h1>
    <p class="mt-3 leading-8 text-brand-700">{t.intro}</p>

    <form id="leave-form" class="mt-6 rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="leave-country" class="mb-1 block text-sm font-semibold text-brand-800">
            {dict.common.countryLabel}
          </label>
          <select id="leave-country" class={inputCls}></select>
        </div>
        <div>
          <label for="leave-years" class="mb-1 block text-sm font-semibold text-brand-800">
            {t.serviceYearsLabel}
          </label>
          <input id="leave-years" type="number" min="0" max="70" step="1" inputmode="numeric" placeholder="0" class={inputCls} />
        </div>
      </div>

      <div id="leave-entitlement" class="mt-4 hidden rounded-xl bg-brand-50 p-4 text-sm"></div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="leave-accrued" class="mb-1 block text-sm font-semibold text-brand-800">
            {t.accruedLabel}
          </label>
          <input id="leave-accrued" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class={inputCls} />
          <p class="mt-1 text-xs leading-5 text-brand-500">{t.accruedHint}</p>
        </div>
        <div>
          <label for="leave-used" class="mb-1 block text-sm font-semibold text-brand-800">
            {t.usedLabel}
          </label>
          <input id="leave-used" type="number" min="0" step="any" inputmode="decimal" placeholder="0" class={inputCls} />
        </div>
      </div>

      <div id="leave-errors" class="mt-4 hidden rounded-xl bg-red-50 p-4 text-sm leading-6 text-red-700"></div>
      <p class="mt-4 text-xs leading-5 text-brand-500">{t.note}</p>
    </form>

    <section id="leave-result" class="mt-6 hidden rounded-2xl border border-gold-300 bg-white p-5 shadow-md sm:p-6" aria-live="polite">
      <h2 class="font-extrabold text-brand-950">{dict.common.resultTitle}</h2>
      <div id="leave-result-body" class="mt-2"></div>
    </section>

    <Disclaimer dict={dict} />
  </div>

  <script type="application/json" id="leave-config" set:html={JSON.stringify(config)} />
  <script>
    import { initLeave } from '../scripts/leave-calculator.js';
    initLeave();
  </script>
</BaseLayout>
