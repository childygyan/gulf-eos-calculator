---
/**
 * components/SalaryNetPage.astro — net-salary calculator page (both locales).
 * Country selector rebuilds the earning inputs from Phase 2 salary data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from './Disclaimer.astro';
import { getDict } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { COUNTRY_CODES, EOS_RULES, SALARY_STRUCTURES } from '../data/index.js';
import { localizedPath } from '../lib/seo.js';
import { softwareAppJsonLd } from '../lib/toolSeo.js';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const t = dict.tools.salaryNet;
const path = '/tools/salary-net/';

const config = {
  locale,
  countries: COUNTRY_CODES.map((code) => ({
    code,
    name: locale === 'ar' ? EOS_RULES[code].nameAr : EOS_RULES[code].nameEn,
    currencyCode: EOS_RULES[code].currencyCode,
    components: SALARY_STRUCTURES[code].components.map((k) => ({
      id: k.id,
      name: locale === 'ar' ? k.nameAr : k.nameEn,
      included: k.includedInEosBasis,
    })),
  })),
  strings: { tool: t, common: dict.common },
};

const jsonLdExtra = softwareAppJsonLd({
  name: t.heading,
  description: t.pageDescription,
  path,
  locale,
});

const inputCls =
  'w-full rounded-xl border border-brand-200 bg-white px-4 py-2.5 text-brand-950 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-300';
---

<BaseLayout locale={locale} path={path} title={t.pageTitle} description={t.pageDescription} jsonLdExtra={jsonLdExtra}>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <a href={localizedPath('/calculators/', locale)} class="text-sm font-semibold text-brand-600 transition hover:text-gold-600">
      <span class="inline-block rtl:rotate-180" aria-hidden="true">←</span>
      {dict.common.backToCalculators}
    </a>
    <h1 class="mt-4 text-3xl font-black text-brand-950 sm:text-4xl">{t.heading}</h1>
    <p class="mt-3 leading-8 text-brand-700">{t.intro}</p>

    <noscript>
      <p class="mt-6 rounded-xl border border-gold-300 bg-gold-50 p-4 text-sm leading-7 text-brand-800">
        {dict.common.jsRequired}
      </p>
    </noscript>
    <form id="salarynet-form" class="mt-6 rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6">
      <div>
        <label for="salarynet-country" class="mb-1 block text-sm font-semibold text-brand-800">
          {dict.common.countryLabel}
        </label>
        <select id="salarynet-country" class={inputCls}></select>
      </div>

      <h2 class="mt-6 font-extrabold text-brand-950">{t.earningsTitle}</h2>
      <div id="salarynet-earnings" class="mt-3 grid gap-4 sm:grid-cols-2"></div>

      <h2 class="mt-6 font-extrabold text-brand-950">{t.deductionsTitle}</h2>
      <p class="mt-1 text-sm leading-6 text-brand-600">{t.deductionsHint}</p>
      <div id="salarynet-deductions" class="mt-3 space-y-3"></div>
      <button
        type="button"
        id="salarynet-add-deduction"
        class="mt-3 rounded-xl border border-dashed border-brand-300 px-4 py-2 text-sm font-bold text-brand-700 transition hover:border-gold-500 hover:text-gold-700"
      >
        + {t.addDeduction}
      </button>

      <div id="salarynet-errors" class="mt-4 hidden rounded-xl bg-red-50 p-4 text-sm leading-6 text-red-700"></div>
    </form>

    <section id="salarynet-result" class="mt-6 hidden rounded-2xl border border-gold-300 bg-white p-5 shadow-md sm:p-6" aria-live="polite">
      <p class="inline-block rounded-full bg-gold-100 px-3 py-1 text-xs font-bold text-gold-800">
        {dict.common.estimateBadge}
      </p>
      <h2 class="mt-2 font-extrabold text-brand-950">{dict.common.resultTitle}</h2>
      <div id="salarynet-result-body" class="mt-2"></div>
    </section>

    <aside class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm leading-7 text-brand-800">
      <p class="font-extrabold text-brand-950">✦ {t.assumptionNote}</p>
    </aside>

    <Disclaimer dict={dict} />
  </div>

  <script type="application/json" id="salarynet-config" set:html={JSON.stringify(config)} />
  <script>
    import { initSalaryNet } from '../scripts/salary-net.js';
    initSalaryNet();
  </script>
</BaseLayout>
