---
/**
 * components/Hero.astro — homepage hero, countries grid, features, CTA band.
 * Original design: deep-navy gradient hero with a gold accent pattern,
 * card grids for countries and features, and a closing CTA band.
 */
import type { Dict } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { localizedPath } from '../lib/seo.js';

interface Props {
  locale: LocaleCode;
  dict: Dict;
}

const { locale, dict } = Astro.props;
const homeHref = localizedPath('/', locale);
---

<section class="relative overflow-hidden bg-brand-950 text-white">
  <div
    class="pointer-events-none absolute inset-0 opacity-20"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 20% 20%, rgba(232,180,68,0.35) 0, transparent 32%), radial-gradient(circle at 80% 70%, rgba(232,180,68,0.22) 0, transparent 36%);"
  ></div>
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <p
      class="inline-flex items-center rounded-full border border-gold-400/40 bg-gold-400/10 px-4 py-1.5 text-sm font-semibold text-gold-300"
    >
      {dict.hero.badge}
    </p>
    <h1 class="mt-6 max-w-3xl text-4xl font-black leading-tight sm:text-5xl">
      {dict.hero.title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-brand-100">{dict.hero.subtitle}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="#countries"
        class="rounded-xl bg-gold-400 px-6 py-3 text-base font-extrabold text-brand-950 shadow-lg transition hover:bg-gold-300"
      >
        {dict.hero.ctaPrimary}
      </a>
      <a
        href="#countries"
        class="rounded-xl border border-brand-600 px-6 py-3 text-base font-bold text-white transition hover:border-gold-400 hover:text-gold-300"
      >
        {dict.hero.ctaSecondary}
      </a>
    </div>
    <p class="mt-4 text-sm text-brand-300">{dict.hero.note}</p>
  </div>
</section>

<section id="countries" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-14 sm:px-6">
  <div class="text-center">
    <h2 class="text-2xl font-black text-brand-950 sm:text-3xl">{dict.countries.title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-brand-600">{dict.countries.subtitle}</p>
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      dict.countries.items.map((c) => (
        <li class="group rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-900 text-xs font-black tracking-wider text-gold-300">
            {c.code}
          </span>
          <p class="mt-3 font-extrabold text-brand-950">{c.name}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="border-y border-brand-100 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="text-center">
      <h2 class="text-2xl font-black text-brand-950 sm:text-3xl">{dict.features.title}</h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-600">{dict.features.subtitle}</p>
    </div>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {
        dict.features.items.map((f) => (
          <li class="rounded-2xl bg-brand-50 p-6">
            <p class="text-lg font-extrabold text-brand-900">{f.title}</p>
            <p class="mt-2 leading-7 text-brand-700">{f.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <div
    class="rounded-3xl bg-gradient-to-br from-gold-400 to-gold-500 px-6 py-12 text-center text-brand-950 shadow-xl sm:px-12"
  >
    <h2 class="text-2xl font-black sm:text-3xl">{dict.cta.title}</h2>
    <p class="mx-auto mt-3 max-w-xl leading-7">{dict.cta.desc}</p>
    <a
      href={`${homeHref}#countries`}
      class="mt-6 inline-block rounded-xl bg-brand-950 px-6 py-3 font-extrabold text-white transition hover:bg-brand-900"
    >
      {dict.cta.button}
    </a>
  </div>
</section>
