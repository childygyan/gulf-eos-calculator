---
/**
 * components/Header.astro — sticky site header: brand mark, nav, language switcher.
 * RTL-first: all spacing uses logical properties (ms-/me-/ps-/pe-).
 *
 * Mobile (< lg): brand + hamburger button; nav links and the language
 * switcher live in a toggleable panel below the bar. The desktop row's
 * intrinsic width (~700px) overflows small viewports, so it is hidden
 * below lg instead of shrinking/wrapping.
 */
import type { Dict } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { localizedPath } from '../lib/seo.js';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: LocaleCode;
  /** Unprefixed path, e.g. `/`. */
  path: string;
  dict: Dict;
}

const { locale, path, dict } = Astro.props;
const homeHref = localizedPath('/', locale);
// Phase 3: calculators hub added; countries anchor kept for the home grid.
const navItems = [
  { label: dict.nav.home, href: homeHref, current: path === '/' },
  {
    label: dict.nav.calculators,
    href: localizedPath('/calculators/', locale),
    current: path === '/calculators/',
  },
  {
    label: dict.nav.faq,
    href: localizedPath('/faq/', locale),
    current: path === '/faq/',
  },
  { label: dict.nav.countries, href: `${homeHref}#countries`, current: false },
];

const desktopLink = (current: boolean) =>
  [
    'whitespace-nowrap rounded-md px-3 py-2 text-sm font-semibold transition',
    current ? 'bg-brand-800 text-gold-300' : 'text-brand-100 hover:bg-brand-800/60 hover:text-white',
  ].join(' ');
const mobileLink = (current: boolean) =>
  [
    'block rounded-md px-3 py-2.5 text-base font-semibold transition',
    current ? 'bg-brand-800 text-gold-300' : 'text-brand-100 hover:bg-brand-800/60 hover:text-white',
  ].join(' ');
---

<header class="sticky top-0 z-40 border-b border-brand-800 bg-brand-950/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={homeHref} class="flex shrink-0 items-center gap-3" aria-label={dict.meta.siteName}>
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-gold-400 text-xl font-black text-brand-950"
        aria-hidden="true"
      >
        {locale === 'ar' ? 'م' : 'M'}
      </span>
      <span class="text-lg font-extrabold tracking-tight text-white">{dict.meta.siteName}</span>
    </a>

    <nav class="hidden items-center gap-1 sm:gap-2 lg:flex" aria-label={dict.nav.home}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class={desktopLink(item.current)}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <LanguageSwitcher locale={locale} path={path} />
    </div>

    <button
      type="button"
      id="site-menu-button"
      aria-expanded="false"
      aria-controls="site-menu"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-brand-100 transition hover:bg-brand-800/60 hover:text-white lg:hidden"
    >
      <span class="sr-only">{dict.nav.menu}</span>
      <svg
        id="site-menu-icon-open"
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        id="site-menu-icon-close"
        class="hidden h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div id="site-menu" hidden class="border-t border-brand-800 bg-brand-950 lg:hidden">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6" aria-label={dict.nav.home}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class={mobileLink(item.current)}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mx-auto max-w-6xl border-t border-brand-800/60 px-4 py-4 sm:px-6">
      <LanguageSwitcher locale={locale} path={path} />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var button = document.getElementById('site-menu-button');
    var menu = document.getElementById('site-menu');
    var iconOpen = document.getElementById('site-menu-icon-open');
    var iconClose = document.getElementById('site-menu-icon-close');
    if (!button || !menu) return;

    function setOpen(open) {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
    }

    button.addEventListener('click', function () {
      setOpen(menu.hidden);
    });

    menu.addEventListener('click', function (event) {
      var target = event.target;
      if (target && target.closest && target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });

    // Reset if the viewport grows to desktop while the panel is open.
    if (window.matchMedia) {
      var mq = window.matchMedia('(min-width: 1024px)');
      var onChange = function (e) {
        if (e.matches) setOpen(false);
      };
      if (mq.addEventListener) mq.addEventListener('change', onChange);
    }
  })();
</script>
