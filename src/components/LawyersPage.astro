---
/**
 * components/LawyersPage.astro — lawyer lead-intake form page (Phase 5).
 *
 * A static site has no backend, so the form is honest about what it does:
 * it validates client-side, then generates a pre-filled email (mailto to
 * the placeholder intake inbox from src/config/site.ts) plus a copyable
 * summary. No lawyer names, firms, or testimonials are shown or invented —
 * the partner program is explicitly labeled as still being set up.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from './AdSlot.astro';
import { getDict, type Dict } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { localizedPath } from '../lib/seo.js';
import { articleJsonLd } from '../lib/toolSeo.js';
import { CASE_TYPES } from '../lib/forms.js';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const s: Dict['lawyers'] = dict.lawyers;
const path = '/lawyers/';

const inputCls =
  'w-full rounded-xl border border-brand-200 bg-white px-4 py-2.5 text-brand-950 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-300';
const labelCls = 'mb-1 block text-sm font-semibold text-brand-800';
const errCls = 'mt-1 text-sm font-medium text-red-700';

const config = {
  countries: dict.countries.items.map((c) => ({ code: c.code, name: c.name })),
  caseTypes: CASE_TYPES.map((id) => ({
    id,
    label: s.caseTypes[id as keyof typeof s.caseTypes],
  })),
  strings: s,
};

const jsonLdExtra = articleJsonLd({
  headline: s.heading,
  description: s.pageDescription,
  path,
  locale,
});
---

<BaseLayout
  locale={locale}
  path={path}
  title={s.pageTitle}
  description={s.pageDescription}
  jsonLdExtra={jsonLdExtra}
>
  <script type="application/json" id="lawyers-config" set:html={JSON.stringify(config)} />
  <script>
    import { initLawyersForm } from '../scripts/lawyers-form.js';
    initLawyersForm();
  </script>

  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <nav aria-label="breadcrumb" class="text-sm text-brand-500">
      <a href={localizedPath('/', locale)} class="hover:text-brand-800">{dict.nav.home}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{s.heading}</span>
    </nav>

    <h1 class="mt-4 text-3xl font-black text-brand-950 sm:text-4xl">{s.heading}</h1>
    <p class="mt-4 text-lg leading-8 text-brand-700">{s.intro}</p>

    <div class="mt-6 rounded-2xl border border-gold-300 bg-gold-50 p-5" role="note">
      <p class="text-sm leading-7 text-brand-800">{s.honestNote}</p>
    </div>

    <AdSlot position="in-article" />

    <form
      id="lawyers-form"
      class="mt-8 rounded-2xl bg-white p-6 shadow-sm sm:p-8"
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="lawyer-country" class={labelCls}>{s.countryLabel}</label>
          <select id="lawyer-country" class={inputCls} aria-describedby="lawyer-err-country">
            <option value="">{s.selectPlaceholder}</option>
            {
              dict.countries.items.map((c) => (
                <option value={c.code}>{c.name}</option>
              ))
            }
          </select>
          <p id="lawyer-err-country" class={`${errCls} hidden`} role="alert"></p>
        </div>
        <div>
          <label for="lawyer-caseType" class={labelCls}>{s.caseTypeLabel}</label>
          <select id="lawyer-caseType" class={inputCls} aria-describedby="lawyer-err-caseType">
            <option value="">{s.selectPlaceholder}</option>
            {
              CASE_TYPES.map((id) => (
                <option value={id}>{s.caseTypes[id as keyof typeof s.caseTypes]}</option>
              ))
            }
          </select>
          <p id="lawyer-err-caseType" class={`${errCls} hidden`} role="alert"></p>
        </div>
        <div>
          <label for="lawyer-name" class={labelCls}>{s.nameLabel}</label>
          <input id="lawyer-name" type="text" autocomplete="name" class={inputCls} aria-describedby="lawyer-err-name" />
          <p id="lawyer-err-name" class={`${errCls} hidden`} role="alert"></p>
        </div>
        <div>
          <label for="lawyer-contact" class={labelCls}>{s.contactLabel}</label>
          <input
            id="lawyer-contact"
            type="text"
            autocomplete="email"
            class={inputCls}
            aria-describedby="lawyer-err-contact"
          />
          <p class="mt-1 text-xs text-brand-500">{s.contactHint}</p>
          <p id="lawyer-err-contact" class={`${errCls} hidden`} role="alert"></p>
        </div>
      </div>
      <div class="mt-5">
        <label for="lawyer-description" class={labelCls}>{s.descriptionLabel}</label>
        <textarea
          id="lawyer-description"
          rows="4"
          class={inputCls}
          aria-describedby="lawyer-err-description"
        ></textarea>
        <p class="mt-1 text-xs text-brand-500">{s.descriptionHint}</p>
        <p id="lawyer-err-description" class={`${errCls} hidden`} role="alert"></p>
      </div>
      <button
        type="submit"
        class="mt-6 w-full rounded-xl bg-brand-900 px-6 py-3 font-bold text-white transition hover:bg-brand-800 sm:w-auto"
      >
        {s.submitLabel}
      </button>
    </form>

    <section
      id="lawyers-confirm"
      class="mt-8 hidden rounded-2xl bg-white p-6 shadow-sm sm:p-8"
      aria-live="polite"
    >
      <h2 class="text-xl font-extrabold text-brand-950">{s.successTitle}</h2>
      <p class="mt-2 leading-7 text-brand-700">{s.successIntro}</p>
      <p id="lawyers-route" class="mt-3 text-sm font-bold text-brand-800"></p>
      <h3 class="mt-6 text-sm font-bold uppercase tracking-wider text-brand-500">
        {s.summaryTitle}
      </h3>
      <pre
        id="lawyers-summary"
        class="mt-2 whitespace-pre-wrap rounded-xl bg-brand-50 p-4 text-sm leading-7 text-brand-900"
      ></pre>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          id="lawyers-mailto"
          href="#"
          class="rounded-xl bg-gold-400 px-6 py-3 font-bold text-brand-950 transition hover:bg-gold-300"
        >
          {s.mailtoLabel}
        </a>
        <button
          id="lawyers-copy"
          type="button"
          class="rounded-xl border border-brand-300 px-6 py-3 font-bold text-brand-800 transition hover:bg-brand-50"
        >
          {s.copyLabel}
        </button>
        <button
          id="lawyers-back"
          type="button"
          class="rounded-xl px-6 py-3 font-semibold text-brand-600 underline hover:text-brand-900"
        >
          {s.backLabel}
        </button>
      </div>
    </section>
  </article>
</BaseLayout>
