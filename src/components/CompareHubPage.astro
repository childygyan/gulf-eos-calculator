---
/**
 * components/CompareHubPage.astro — all-six-countries EOS comparison (Phase 4).
 *
 * Every cell is rendered from the Phase 2 data model via lib/guide.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDict, fill } from '../i18n/dict.js';
import type { LocaleCode } from '../i18n/locales.js';
import { EOS_RULES, COUNTRY_CODES } from '../data/index.js';
import { COUNTRY_SLUGS } from '../lib/countries.js';
import { localizedPath } from '../lib/seo.js';
import { articleJsonLd } from '../lib/toolSeo.js';
import { tierSentence } from '../lib/guide.js';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const path = '/compare/gulf-eos/';
const joiner = locale === 'ar' ? '؛ ' : '; ';

const rows = COUNTRY_CODES.map((code) => {
  const rules = EOS_RULES[code];
  const term = rules.scenarios.find((s) => s.id === 'termination')!;
  const resign = rules.scenarios.find((s) => s.id === 'resignation')!;
  const reduces = resign.resignationBands?.some((b) => b.fraction < 1 - 1e-9) ?? false;
  return {
    code,
    name: locale === 'ar' ? rules.nameAr : rules.nameEn,
    guideHref: localizedPath(`/guides/${COUNTRY_SLUGS[code]}/`, locale),
    formula: term.tiers
      .map((t, i) => tierSentence(code, t, i, term.tiers, locale))
      .join(joiner),
    basis: dict.eos.basisShort[rules.wageBasis.kind],
    resignation: reduces ? dict.compare.resignReduced : dict.compare.resignFull,
    cap:
      term.capMonths === null
        ? dict.compare.noCap
        : fill(dict.compare.capValue, { n: term.capMonths }),
    min:
      term.minServiceYears <= 0
        ? dict.compare.minNone
        : fill(dict.compare.minValue, { n: term.minServiceYears }),
  };
});

const jsonLdExtra = articleJsonLd({
  headline: dict.compare.hubHeading,
  description: dict.compare.hubDescription,
  path,
  locale,
});
---

<BaseLayout
  locale={locale}
  path={path}
  title={dict.compare.hubTitle}
  description={dict.compare.hubDescription}
  jsonLdExtra={jsonLdExtra}
>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="breadcrumb" class="text-sm text-brand-500">
      <a href={localizedPath('/', locale)} class="hover:text-brand-800">{dict.nav.home}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{dict.compare.hubHeading}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-black text-brand-950 sm:text-4xl">{dict.compare.hubHeading}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-brand-700">{dict.compare.hubIntro}</p>

    <div class="mt-8 overflow-x-auto rounded-2xl bg-white shadow-sm">
      <table class="w-full min-w-[900px] text-start text-sm leading-7">
        <thead>
          <tr class="border-b border-brand-100 bg-brand-50 text-brand-900">
            <th class="px-4 py-3 font-extrabold">{dict.compare.colCountry}</th>
            <th class="px-4 py-3 font-extrabold">{dict.compare.colFormula}</th>
            <th class="px-4 py-3 font-extrabold">{dict.compare.colBasis}</th>
            <th class="px-4 py-3 font-extrabold">{dict.compare.colResignation}</th>
            <th class="px-4 py-3 font-extrabold">{dict.compare.colCap}</th>
            <th class="px-4 py-3 font-extrabold">{dict.compare.colMin}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class="border-b border-brand-50 align-top transition hover:bg-brand-50/50">
                <td class="px-4 py-4 font-extrabold">
                  <a href={r.guideHref} class="text-brand-800 underline hover:text-brand-950">
                    {r.name}
                  </a>
                </td>
                <td class="px-4 py-4 text-brand-700">{r.formula}</td>
                <td class="px-4 py-4 text-brand-700">{r.basis}</td>
                <td class="px-4 py-4 text-brand-700">{r.resignation}</td>
                <td class="px-4 py-4 text-brand-700">{r.cap}</td>
                <td class="px-4 py-4 text-brand-700">{r.min}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm">
      <h2 class="text-xl font-extrabold text-brand-900">{dict.compare.notesTitle}</h2>
      <ul class="mt-3 list-disc space-y-2 ps-5 leading-7 text-brand-700">
        {dict.compare.hubNotes.map((n) => <li>{n}</li>)}
      </ul>
    </section>

    <section class="mt-6">
      <h2 class="text-xl font-extrabold text-brand-900">{dict.guides.relatedGuides}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {
          rows.map((r) => (
            <li class="rounded-2xl bg-white p-5 shadow-sm transition hover:shadow-md">
              <a href={r.guideHref} class="font-extrabold text-brand-900 hover:text-brand-700">
                {r.name}
              </a>
              <p class="mt-1 text-sm text-brand-500">
                <a
                  href={localizedPath(`/calculator/${COUNTRY_SLUGS[r.code]}/`, locale)}
                  class="underline hover:text-brand-800"
                >
                  {dict.countries.calcLink}
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
